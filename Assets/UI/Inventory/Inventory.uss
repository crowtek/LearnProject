:root {
}

.list {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.item {
    background-color: rgba(67, 67, 67, 0.7);
    width: 100px;
    height: 100px;
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    border-left-color: rgba(255, 255, 255, 0.62);
    border-right-color: rgba(255, 255, 255, 0.62);
    border-top-color: rgba(255, 255, 255, 0.62);
    border-bottom-color: rgba(255, 255, 255, 0.62);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

.item-icon {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

.item-amount {
    position: absolute;
    left: 5px;
    bottom: 0;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-outline-width: 0.3px;
    -unity-text-outline-color: rgb(0, 0, 0);
    right: auto;
}

.item-eq {
    position: absolute;
    top: 0;
    right: 5px;
    color: rgb(209, 180, 68);
    -unity-font-style: bold-and-italic;
    -unity-text-outline-width: 0.1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    font-size: 18px;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.43);
}

.item-focused {
    border-color: gold;
    border-width: 2px;
    background-color: rgba(255, 215, 0, 0.2);
}

.ItemDetails {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 20px;
}

.DetailsContainer {
    width: 300px;
    height: 60%;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    flex-grow: 1;
    max-height: none;
}

.itemMenu {
    margin-top: 20px;
    padding-top: 10px;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.itemMenu-button {
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 255, 255);
    -unity-text-align: upper-left;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0.2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Imports/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
    cursor: url("project://database/Assets/Images/Cursor.png?fileID=2800000&guid=0fac0d3a33f7b3a42946bf0a5104f507&type=3#Cursor");
    padding-left: 20px;
}

.itemMenu-button:hover {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 18px;
    color: rgb(233, 192, 105);
    -unity-text-outline-width: 0.2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.text {
    color: rgb(253, 253, 253);
    font-size: 18px;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-style: bold;
    white-space: pre-wrap;
}

.box {
    background-color: rgba(2, 2, 2, 0.66);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}
